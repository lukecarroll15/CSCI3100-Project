# Runtime
NODE_ENV=development
PORT=5001
API_PREFIX=/api

# CORS
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/taskflow_dev

# Sessions / security (SF-UM will use this)
SESSION_SECRET=dev_secret_dev_secret_dev_secret_12345
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# OTP policy (SF-UM)
# Either leave blank to use defaults or override as needed.
OTP_LENGTH=6
OTP_EXPIRES_MS=600000 # fallback to OTP_TTL_SECONDS * 1000 when unset
OTP_RESEND_COOLDOWN_MS=30000 # fallback to OTP_RESEND_COOLDOWN_SECONDS * 1000 when unset
OTP_MAX_ATTEMPTS=5 # fallback to OTP_MAX_VERIFY_ATTEMPTS when unset
OTP_BCRYPT_ROUNDS=10
# Legacy seconds-based fields (optional):
# OTP_TTL_SECONDS=600
# OTP_RESEND_COOLDOWN_SECONDS=30
# OTP_MAX_VERIFY_ATTEMPTS=5

# Email (SMTP)
EMAIL_FROM=no-reply@taskflow.local

# Leave unset (or blank) to use log fallback:
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Recommended local SMTP for OTP testing (Mailpit):
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025

# Rate limiting (global/auth)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Logging
LOG_LEVEL=info

# GitHub OAuth (optional, for "Login with GitHub")
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5001/api/v1/auth/github/callback
GITHUB_SCOPES=read:user user:email
FRONTEND_URL=http://localhost:5173

# Dev-only: seed an initial admin activation key (must match AAAA-BBBB-CCCC)
# If unset, the backend will generate one on startup (non-production only) and print it.
INITIAL_ADMIN_KEY=

# Admin key policy
# Set ADMIN_KEY_TTL_DAYS=0 to disable expiry.
ADMIN_KEY_MAX_USES=5
ADMIN_KEY_TTL_DAYS=30
ADMIN_KEY_AUTO_SEED=true

# Team invites (days before an invite expires)
TEAM_INVITE_TTL_DAYS=7
