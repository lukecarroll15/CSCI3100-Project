# Runtime
NODE_ENV=development
PORT=5001
API_PREFIX=/api

# CORS
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/taskflow_dev

# Sessions / security (SF-UM will use this)
SESSION_SECRET=dev_secret_dev_secret_dev_secret_12345
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# OTP policy (SF-UM)
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5

# Email (SMTP)
EMAIL_FROM=no-reply@taskflow.local

# Leave unset (or blank) to use log fallback:
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Recommended local SMTP for OTP testing (Mailpit):
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025

# Rate limiting (global/auth)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Logging
LOG_LEVEL=info
