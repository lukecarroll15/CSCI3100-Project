# Runtime
NODE_ENV=development
PORT=5000

# CORS (frontend dev server origin)
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/taskflow_dev

# Session / security (we will use this for auth later)
SESSION_SECRET=change_me_to_a_long_random_string
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# OTP policy (for SF-UM)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30

# Email service (SMTP example)
EMAIL_PROVIDER=smtp
EMAIL_FROM="TaskFlow <no-reply@taskflow.local>"

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Basic rate limiting (for OTP endpoints later)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Logging
LOG_LEVEL=info
